# 필수: 디스코드 봇 토큰 (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# 권장: Gemini API 키 (https://aistudio.google.com/apikey 에서 무료 발급).
# 비워 두면 키워드 기반 간이 분류로 동작합니다(시연 전 연결 확인용).
GEMINI_API_KEY=
# 무료 등급은 Flash·Flash-Lite 계열만 됩니다. 기본값은 최신 Flash를 가리키는 별칭입니다.
GEMINI_MODEL=gemini-flash-latest

# 선택: Claude를 쓰려면 아래 키를 넣고 AI_PROVIDER=claude (두 키가 다 있으면 Gemini가 기본)
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 선택: 슬래시 명령을 즉시 등록할 서버 ID (쉼표 구분). 비우면 전역 등록(반영까지 최대 1시간).
GUILD_IDS=

# 봇이 자기 컴퓨터에 남기는 자료 사본과 기록(DB) 위치. 그대로 두면 됩니다.
# (구글 드라이브 업로드는 아래 GOOGLE_CREDENTIALS로 켭니다.)
DATA_DIR=./data
ARCHIVE_DIR=./data/archive
# 드라이브 연동 없이 쓸 때만: 위 폴더를 직접 동기화해 둔 드라이브 폴더의 웹 주소. 보통 비워 둡니다.
ARCHIVE_BASE_URL=

# 주제 태그 고정 목록
TOPIC_TAGS=기획,리서치,디자인,개발,발표,회의록,재무,마케팅,기타
# AI 확신도가 이 값보다 낮으면 공유 의도는 버튼, 주제 태그는 메뉴로 확인을 요청합니다 (0~1)
CONFIDENCE_THRESHOLD=0.75
# 처음 쓸 때 태그·공유 의도 기준 규칙을 미리 등록합니다 (/규칙 목록에서 고치거나 지울 수 있음). 끄려면 0
DEFAULT_RULES=1
# 분류할 때 함께 읽는 직전 메시지 수 (저장하지 않고 분류에만 사용). 0이면 읽지 않음
CONTEXT_MESSAGES=3
# 확인 메시지를 자동으로 지우기까지의 시간(초)
PROMPT_TTL=600
MAX_FILE_MB=25
# 이미지(png·jpg·webp)는 AI가 읽어 보고 업무 자료일 때만 보관합니다 (밈·짤은 무시). API 키가 없으면 이미지는 건너뜁니다.
ARCHIVE_EXTENSIONS=pdf,pptx,ppt,docx,doc,xlsx,xls,hwp,hwpx,txt,md,csv,key,zip,png,jpg,jpeg,webp
# 스캔 PDF는 앞에서부터 이 쪽수만 AI에게 보여 줍니다
OCR_MAX_PAGES=20

# 선택: 구글 드라이브·시트 연동. README의 "구글 드라이브 연결하기"를 따라 만든 토큰 파일 경로,
# 또는 파일 내용 전체(JSON). Railway 같은 클라우드에서는 내용 전체를 붙여 넣으세요.
GOOGLE_CREDENTIALS=
# 서비스 계정을 쓸 때만 필수: 서비스 계정과 공유한 공유 드라이브 폴더 ID (폴더 주소 맨 끝 부분)
GOOGLE_DRIVE_FOLDER_ID=
